{
  "name": "@haksanlulz/mcp-chat",
  "version": "0.1.0",
  "description": "Testbed for driving MCP servers the way a model does: a TypeScript tool loop over stdio servers, a local (Ollama) or hosted (Anthropic) model, and a React front end that shows every call and result. Not a chat product.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "Abishai James"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "start": "node --import tsx server/launch.ts",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build:web": "vite build",
    "test": "vitest run",
    "smoke": "node --import tsx smoke.ts",
    "screenshot": "node tools/screenshot.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint ."
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "ajv": "^8.20.0",
    "ajv-draft-04": "^1.0.0",
    "ajv-formats": "^3.0.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "10.16.0",
    "eslint-plugin-no-unsanitized": "4.1.5",
    "tsx": "^4.20.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "8.74.0",
    "vite": "^8.4.0",
    "vitest": "^5.0.1"
  }
}
